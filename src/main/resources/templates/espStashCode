#include <WiFi.h>
#include <PubSubClient.h>
#include "esp_camera.h"
#include <ArduinoJson.h>

/* =========================
   WIFI
========================= */
const char* WIFI_SSID = "FPT-Telecom-910A";
const char* WIFI_PASSWORD = "1234567809";

/* =========================
   MQTT
========================= */
const char* MQTT_BROKER = "192.168.0.101";
const int MQTT_PORT = 1883;
const char* MQTT_USER = "";
const char* MQTT_PASS = "";

/* =========================
   DEVICE INFO
========================= */
const char* DEVICE_ID = "ESP32CAM_001";
const char* TYPE_ID = "RC_CAR_CAMERA";
const char* DEVICE_NAME = "RC Car camera ESP";
const char* FW_VERSION = "1.0.0";

WiFiClient wifiClient;
PubSubClient mqttClient(wifiClient);

unsigned long lastReconnectAttempt = 0;

/* ============================================================
   MQTT CALLBACK
============================================================ */

void mqttCallback(char* topic, byte* payload, unsigned int length) {

    String message;

    for (int i = 0; i < length; i++) {
        message += (char)payload[i];
    }

    Serial.println("=================================");
    Serial.println("MQTT MESSAGE");
    Serial.println("Topic:");
    Serial.println(topic);

    Serial.println("Payload:");
    Serial.println(message);

    StaticJsonDocument<1024> doc;

    DeserializationError error =
        deserializeJson(doc, message);

    if (error) {
        Serial.println("JSON Parse Error");
        return;
    }

    int configVersion =
        doc["configVersion"] | 0;

    String server =
        doc["stream"]["server"] | "";

    int udpPort =
        doc["stream"]["udpPort"] | 0;

    Serial.println("CONFIG RECEIVED");
    Serial.print("Version: ");
    Serial.println(configVersion);

    Serial.print("Server: ");
    Serial.println(server);

    Serial.print("UDP Port: ");
    Serial.println(udpPort);

    // TODO:
    // lưu config vào Preferences/NVS
    // khởi động stream video
}
/* ============================================================
   WIFI
============================================================ */
void connectWifi() {

    Serial.println();
    Serial.println("Connecting WiFi...");

    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }

    Serial.println();
    Serial.println("WiFi Connected");

    Serial.print("IP: ");
    Serial.println(WiFi.localIP());

    Serial.print("MAC: ");
    Serial.println(WiFi.macAddress());
}

/* ============================================================
   REGISTER DEVICE
============================================================ */
void registerDevice() {

    StaticJsonDocument<1024> doc;

    doc["deviceId"] = DEVICE_ID;
    doc["typeId"] = TYPE_ID;
    doc["deviceName"] = DEVICE_NAME;
    doc["firmware"] = FW_VERSION;
    doc["ipAddress"] = WiFi.localIP().toString();
    doc["macAddress"] = WiFi.macAddress();
    doc["configJson"] = "{}";

    String payload;
    serializeJson(doc, payload);

 // Topic register theo device
    String topic =
        "devices/" +
        String(DEVICE_ID) +
        "/register";
    Serial.print("Topic: ");
    Serial.println(topic);
    bool result = mqttClient.publish(
        topic.c_str(),
        payload.c_str(),
        false
    );

    Serial.println("=================================");
    Serial.println("REGISTER DEVICE");

    if (result) {
        Serial.println("SUCCESS");
    } else {
        Serial.println("FAILED");
    }

    Serial.println(payload);
}

/* ============================================================
   MQTT CONNECT
============================================================ */
void connectMqtt() {

    while (!mqttClient.connected()) {

        Serial.println("Connecting MQTT...");

        bool connected;

        if (strlen(MQTT_USER) > 0) {

            connected = mqttClient.connect(
                DEVICE_ID,
                MQTT_USER,
                MQTT_PASS
            );

        } else {

            connected =
                mqttClient.connect(DEVICE_ID);
        }

        if (connected) {

            Serial.println("MQTT Connected");

            String configTopic =
                "devices/" +
                String(DEVICE_ID) +
                "/config";

            mqttClient.subscribe(configTopic.c_str(), 1);

            Serial.println("Subscribed:");
            Serial.println(configTopic);

            registerDevice();

        } else {

            Serial.print("MQTT Failed rc=");
            Serial.println(mqttClient.state());

            delay(3000);
        }
    }
}

/* ============================================================
   SETUP
============================================================ */
void setup() {

    Serial.begin(115200);

    delay(1000);

    connectWifi();

    mqttClient.setServer(
        MQTT_BROKER,
        MQTT_PORT
    );

    mqttClient.setCallback(mqttCallback);

    connectMqtt();
}

/* ============================================================
   LOOP
============================================================ */
void loop() {

    if (WiFi.status() != WL_CONNECTED) {

        Serial.println("WiFi Lost");

        WiFi.disconnect();
        WiFi.reconnect();

        delay(5000);
        return;
    }

    if (!mqttClient.connected()) {

        unsigned long now = millis();

        if (now - lastReconnectAttempt > 5000) {

            lastReconnectAttempt = now;

            connectMqtt();
        }
    }

    mqttClient.loop();

    // Ví dụ gửi heartbeat mỗi 30s
    static unsigned long lastHeartbeat = 0;

    if (millis() - lastHeartbeat > 30000) {

        lastHeartbeat = millis();

        String topic =
            "devices/" +
            String(DEVICE_ID) +
            "/heartbeat";

        StaticJsonDocument<256> doc;

        doc["deviceId"] = DEVICE_ID;
        doc["freeHeap"] = ESP.getFreeHeap();
        doc["uptime"] = millis();

        String payload;
        serializeJson(doc, payload);

        mqttClient.publish(
            topic.c_str(),
            payload.c_str(),
            false
        );

        Serial.println("Heartbeat sent");
    }
}
