#include <WiFi.h>
#include <WiFiUdp.h>
#include <PubSubClient.h>
#include "esp_camera.h"
#include <ArduinoJson.h>

/* =========================
   WIFI
========================= */
const char* WIFI_SSID = "FPT-Telecom-910A";
const char* WIFI_PASSWORD = "1234567809";

/* =========================
   MQTT
========================= */
const char* MQTT_BROKER = "192.168.0.101";
const int MQTT_PORT = 1883;

/* =========================
   DEVICE
========================= */
const char* DEVICE_ID = "ESP32CAM_001";
const char* TYPE_ID = "RC_CAR_CAMERA";
const char* DEVICE_NAME = "RC CAR CAMERA";
const char* FW_VERSION = "1.0.0";

/* =========================
   CORE
========================= */
WiFiClient wifiClient;
PubSubClient mqttClient(wifiClient);
WiFiUDP videoUdp;

/* =========================
   STREAM CONFIG (FROM CONFIG ONLY)
========================= */
String udpServerIp = "";
uint16_t udpServerPort = 0;
uint32_t streamId = 0;

bool streaming = false;

/* =========================
   CAMERA AI THINKER
========================= */
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0

#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27

#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5

#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

/* =========================
   UDP PACKET
========================= */
struct PacketHeader {
    uint32_t streamId;
    uint32_t frameId;
    uint16_t totalChunks;
    uint16_t chunkIndex;
} __attribute__((packed));

const int CHUNK_SIZE = 1400;
uint32_t frameId = 0;

/* =========================
   TIMING
========================= */
unsigned long lastFrameTime = 0;
unsigned long lastHeartbeat = 0;
unsigned long lastReconnect = 0;

const int TARGET_FPS = 25;
const int FRAME_INTERVAL = 1000 / TARGET_FPS;

/* ============================================================
   WIFI
============================================================ */
void connectWifi()
{
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    Serial.print("WiFi connecting");

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println("\nWiFi OK");
    Serial.println(WiFi.localIP());
}

/* ============================================================
   MQTT CALLBACK
============================================================ */
void mqttCallback(char* topic, byte* payload, unsigned int length)
{
    String msg;
    for (int i = 0; i < length; i++)
        msg += (char)payload[i];

    Serial.println("MQTT:");
    Serial.println(msg);

    StaticJsonDocument<512> doc;

    if (deserializeJson(doc, msg))
        return;

    String cmd = doc["cmd"] | "";

    /* =========================
       CONFIG (CHỈ SET 1 LẦN)
    ========================= */
    if (doc.containsKey("stream") && doc.containsKey("configVersion"))
    {
        JsonObject stream = doc["stream"];

        streamId = doc["streamId"] | 0;
        udpServerIp = stream["server"] | "";
        udpServerPort = stream["udpPort"] | 0;

        Serial.println("CONFIG RECEIVED");
        Serial.println(udpServerIp);
        Serial.println(udpServerPort);
        return;
    }

    /* =========================
       CONTROL
    ========================= */
    if (cmd == "START_STREAM")
    {
        streaming = true;
        Serial.println("STREAM ON");
    }
    else if (cmd == "STOP_STREAM")
    {
        streaming = false;
        Serial.println("STREAM OFF");
    }
}

/* ============================================================
   MQTT CONNECT
============================================================ */
bool connectMqtt()
{
    bool ok = mqttClient.connect(DEVICE_ID);

    if (!ok) return false;

    String configTopic =
        "devices/" + String(DEVICE_ID) + "/config";

    String controlTopic =
        "devices/" + String(DEVICE_ID) + "/control";

    mqttClient.subscribe(configTopic.c_str(), 1);
    mqttClient.subscribe(controlTopic.c_str(), 1);

    Serial.println("MQTT CONNECTED");
    return true;
}

/* ============================================================
   REGISTER
============================================================ */
void registerDevice()
{
    StaticJsonDocument<512> doc;

    doc["serialNumber"] = DEVICE_ID;
    doc["typeId"] = TYPE_ID;
    doc["deviceName"] = DEVICE_NAME;
    doc["firmware"] = FW_VERSION;

    String payload;
    serializeJson(doc, payload);

    String topic =
        "devices/" + String(DEVICE_ID) + "/register";

    mqttClient.publish(topic.c_str(), payload.c_str());
}

/* ============================================================
   CAMERA
============================================================ */
bool initCamera()
{
    if (!psramFound()) return false;

    camera_config_t config;
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;

    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;

    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;

    config.pin_sccb_sda = SIOD_GPIO_NUM;
    config.pin_sccb_scl = SIOC_GPIO_NUM;

    config.pin_pwdn = PWDN_GPIO_NUM;
    config.pin_reset = RESET_GPIO_NUM;

    config.xclk_freq_hz = 30000000;
    config.pixel_format = PIXFORMAT_JPEG;

    config.frame_size = FRAMESIZE_HVGA;
    config.jpeg_quality = 10;

    config.fb_count = 2;
    config.grab_mode = CAMERA_GRAB_LATEST;
    config.fb_location = CAMERA_FB_IN_PSRAM;

    return esp_camera_init(&config) == ESP_OK;
}

/*
|--------------------------------------------------------------------------
| SEND FRAME (DEBUG FULL)
|--------------------------------------------------------------------------
*/
void sendFrame(camera_fb_t* fb)
{
    if (!fb || !streaming) return;

    uint16_t totalChunks =
        (fb->len + CHUNK_SIZE - 1) / CHUNK_SIZE;

    for (uint16_t chunkIndex = 0;
         chunkIndex < totalChunks;
         chunkIndex++)
    {
        int offset = chunkIndex * CHUNK_SIZE;

        int payloadSize =
            min(CHUNK_SIZE, (int)(fb->len - offset));

        PacketHeader header;

        header.streamId = htonl(streamId);
        header.frameId = htons(frameId);
        header.totalChunks = htons(totalChunks);
        header.chunkIndex = htons(chunkIndex);

        videoUdp.beginPacket(
            udpServerIp.c_str(),
            udpServerPort
        );

        videoUdp.write(
            (uint8_t*)&header,
            sizeof(header)
        );

        videoUdp.write(
            fb->buf + offset,
            payloadSize
        );

        videoUdp.endPacket();
        yield();
    }

    frameId++;
}

/* ============================================================
   SETUP
============================================================ */
void setup()
{
    Serial.begin(115200);

    connectWifi();

    initCamera();

    videoUdp.begin(5000);

    mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
    mqttClient.setCallback(mqttCallback);

    connectMqtt();

    registerDevice();
}

/* ============================================================
   LOOP
============================================================ */
void loop()
{
    if (!mqttClient.connected())
    {
        if (millis() - lastReconnect > 5000)
        {
            lastReconnect = millis();
            connectMqtt();
        }
    }

    mqttClient.loop();

    /* HEARTBEAT */
    if (millis() - lastHeartbeat > 30000)
    {
        lastHeartbeat = millis();

        StaticJsonDocument<256> doc;
        doc["streaming"] = streaming;

        String payload;
        serializeJson(doc, payload);

        mqttClient.publish(
            ("devices/" + String(DEVICE_ID) + "/heartbeat").c_str(),
            payload.c_str()
        );
    }

    /* STREAM */
    if (streaming)
    {
        unsigned long now = millis();

        if (now - lastFrameTime >= FRAME_INTERVAL)
        {
            lastFrameTime = now;

            camera_fb_t* fb = esp_camera_fb_get();

            if (fb)
            {
                sendFrame(fb);
                esp_camera_fb_return(fb);
            }
        }
    }
}