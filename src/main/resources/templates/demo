# UdpVideoServer.java

```java
package com.example.camera.udp;

import com.example.camera.ws.VideoWebSocketHandler;
import jakarta.annotation.PostConstruct;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import java.net.DatagramPacket;
import java.net.DatagramSocket;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Component
@RequiredArgsConstructor
public class UdpVideoServer {

    private final VideoWebSocketHandler socketHandler;

    private final Map<Integer, FrameBuffer> frameBuffers =
            new ConcurrentHashMap<>();

    @PostConstruct
    public void start() {

        Thread thread = new Thread(this::runUdp);

        thread.setDaemon(true);

        thread.start();
    }

    private void runUdp() {

        try {

            DatagramSocket socket =
                    new DatagramSocket(5000);

            byte[] receiveBuffer = new byte[1500];

            while (true) {

                DatagramPacket packet =
                        new DatagramPacket(
                                receiveBuffer,
                                receiveBuffer.length
                        );

                socket.receive(packet);

                processPacket(packet);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void processPacket(DatagramPacket packet) {

        try {

            ByteBuffer bb = ByteBuffer.wrap(
                    packet.getData(),
                    0,
                    packet.getLength()
            );

            bb.order(ByteOrder.BIG_ENDIAN);

            int cameraId = bb.get() & 0xff;

            int frameId = bb.getShort() & 0xffff;

            int totalChunks = bb.getShort() & 0xffff;

            int chunkIndex = bb.getShort() & 0xffff;

            byte[] chunk =
                    new byte[packet.getLength() - 7];

            bb.get(chunk);

            int key =
                    (cameraId << 16) | frameId;

            FrameBuffer fb =
                    frameBuffers.computeIfAbsent(
                            key,
                            k -> {

                                FrameBuffer f =
                                        new FrameBuffer();

                                f.totalChunks = totalChunks;

                                return f;
                            }
                    );

            fb.chunks.put(chunkIndex, chunk);

            fb.lastUpdate = System.currentTimeMillis();

            if (fb.isComplete()) {

                byte[] image = fb.buildFrame();

                if (image != null) {
                    socketHandler.broadcast(cameraId, image);
                }

                frameBuffers.remove(key);
            }

            cleanup();

        } catch (Exception ignored) {
        }
    }

    private void cleanup() {

        long now = System.currentTimeMillis();

        frameBuffers.entrySet().removeIf(
                e -> now - e.getValue().lastUpdate > 3000
        );
    }
}
