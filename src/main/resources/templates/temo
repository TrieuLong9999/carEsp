unsigned long lastFrameTime = 0;
const int TARGET_FPS = 25;
const int FRAME_INTERVAL = 1000 / TARGET_FPS;

void sendFrame(camera_fb_t* fb)
{
    if (!fb)
        return;

    uint16_t totalChunks =
        (fb->len + CHUNK_SIZE - 1)
        / CHUNK_SIZE;

    for (uint16_t chunkIndex = 0;
         chunkIndex < totalChunks;
         chunkIndex++)
    {
        int offset =
            chunkIndex * CHUNK_SIZE;

        int payloadSize =
            min(
                CHUNK_SIZE,
                (int)(fb->len - offset)
            );

        PacketHeader header;

        header.streamId =
            htonl(streamId);

        header.frameId =
            htonl(frameId);

        header.totalChunks =
            htons(totalChunks);

        header.chunkIndex =
            htons(chunkIndex);

        videoUdp.beginPacket(
            udpServerIp.c_str(),
            udpServerPort
        );

        videoUdp.write(
            (uint8_t*)&header,
            sizeof(header)
        );

        videoUdp.write(
            fb->buf + offset,
            payloadSize
        );

        videoUdp.endPacket();
        yield();
    }

    frameId++;
}

