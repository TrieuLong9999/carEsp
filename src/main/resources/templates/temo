   MQTT
============================================================ */
bool connectMqtt()
{
    bool connected;

    if (strlen(MQTT_USER))
    {
        connected =
            mqttClient.connect(
                DEVICE_ID,
                MQTT_USER,
                MQTT_PASS
            );
    }
    else
    {
        connected =
            mqttClient.connect(
                DEVICE_ID
            );
    }

    if (!connected)
        return false;

    String configTopic =
        "devices/" +
        String(DEVICE_ID) +
        "/config";

    mqttClient.subscribe(
        configTopic.c_str(),
        1
    );

    registerDevice();

    Serial.println("MQTT Connected");

    return true;
}

/* ============================================================
   CAMERA
============================================================ */
bool initCamera()
{
    if (!psramFound())
    {
        Serial.println("PSRAM NOT FOUND");
        return false;
    }

    camera_config_t config;

    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;

    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;

    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;

    config.pin_sccb_sda = SIOD_GPIO_NUM;
    config.pin_sccb_scl = SIOC_GPIO_NUM;

    config.pin_pwdn = PWDN_GPIO_NUM;
    config.pin_reset = RESET_GPIO_NUM;

    config.xclk_freq_hz = 30000000;

    config.pixel_format = PIXFORMAT_JPEG;

    config.frame_size = FRAMESIZE_HVGA;
    config.jpeg_quality = 15;

    config.fb_count = 3;
    config.grab_mode = CAMERA_GRAB_LATEST;
    config.fb_location = CAMERA_FB_IN_PSRAM;

    esp_err_t err =
        esp_camera_init(&config);

    if (err != ESP_OK)
    {
        Serial.printf(
            "Camera Error 0x%x\n",
            err
        );
        return false;
    }

    sensor_t* s = esp_camera_sensor_get();

    s->set_brightness(s, 0);
    s->set_contrast(s, 0);
    s->set_saturation(s, 0);

    Serial.println("Camera Ready");

    return true;
}

/* ============================================================
   SEND FRAME
============================================================ */
unsigned long lastFrameTime = 0;
const int TARGET_FPS = 25;
const int FRAME_INTERVAL = 1000 / TARGET_FPS;

void sendFrame(camera_fb_t* fb)
{
    if (!fb)
        return;

    uint16_t totalChunks =
        (fb->len + CHUNK_SIZE - 1)
        / CHUNK_SIZE;

    for (uint16_t chunkIndex = 0;
         chunkIndex < totalChunks;
         chunkIndex++)
    {
        int offset =
            chunkIndex * CHUNK_SIZE;

        int payloadSize =
            min(
                CHUNK_SIZE,
                (int)(fb->len - offset)
            );

        PacketHeader header;

        header.streamId =
            htonl(streamId);

        header.frameId =
            htonl(frameId);

        header.totalChunks =
            htons(totalChunks);

        header.chunkIndex =
            htons(chunkIndex);

        videoUdp.beginPacket(
            udpServerIp.c_str(),
            udpServerPort
        );

        videoUdp.write(
            (uint8_t*)&header,
            sizeof(header)
        );

        videoUdp.write(
            fb->buf + offset,
            payloadSize
        );

        videoUdp.endPacket();
        yield();
    }

    frameId++;
}

/* ============================================================
   HEARTBEAT
============================================================ */
void sendHeartbeat()
{
    StaticJsonDocument<256> doc;

    doc["serialNumber"] = DEVICE_ID;
    doc["freeHeap"] = ESP.getFreeHeap();
    doc["uptime"] = millis();
    doc["streaming"] = streaming;

    String payload;
    serializeJson(doc, payload);

    String topic =
        "devices/" +
        String(DEVICE_ID) +
        "/heartbeat";

    mqttClient.publish(
        topic.c_str(),
        payload.c_str()
    );
}

/* ============================================================
   SETUP
============================================================ */
void setup()
{
    Serial.begin(115200);

    connectWifi();

    initCamera();

    videoUdp.begin(5000);

    mqttClient.setServer(
        MQTT_BROKER,
        MQTT_PORT
    );

    mqttClient.setCallback(
        mqttCallback
    );

    connectMqtt();
}

/* ============================================================
   LOOP
============================================================ */
void loop()
{
    if (WiFi.status() != WL_CONNECTED)
    {
        WiFi.disconnect();
        WiFi.reconnect();

        delay(1000);
        return;
    }

    if (!mqttClient.connected())
    {
        if (millis() - lastReconnect > 5000)
        {
            lastReconnect = millis();
            connectMqtt();
        }
    }

    mqttClient.loop();

    if (millis() - lastHeartbeat > 30000)
    {
        lastHeartbeat = millis();
        sendHeartbeat();
    }

    if (streaming)
    {
        unsigned long now = millis();

        if (now - lastFrameTime >= FRAME_INTERVAL)
        {
            lastFrameTime = now;

            camera_fb_t* fb = esp_camera_fb_get();

            if (fb)
            {
                sendFrame(fb);
                esp_camera_fb_return(fb);
            }
        }
    }
}
